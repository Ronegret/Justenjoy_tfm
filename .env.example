# ─────────────────────────────────────────────────────────────────────────────
# Just Enjoy — Variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este fichero como ".env" (nunca lo commitees):
#        cp .env.example .env
#   2. Rellena cada variable con el valor real.
#   3. Rota INMEDIATAMENTE cualquier clave que haya quedado en el historial de git.
#
# NOTA DE SEGURIDAD sobre el workflow n8n:
#   El fichero n8n/workflows/Planificador_de_Viajes_v24.json contiene IDs internos
#   de credenciales de n8n (ej: "id": "HEk6ZsM7dKsfAlMs") pero NO las claves reales.
#   Las claves reales se almacenan en la base de datos cifrada de tu instancia n8n
#   y NUNCA deben aparecer en este repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=changeme

# ── SerpAPI (vuelos, hoteles, Google Maps) ────────────────────────────────────
SERPAPI_KEY=changeme

# ── Tavily (búsqueda web) ─────────────────────────────────────────────────────
TAVILY_API_KEY=changeme

# ── Stripe Connect (pagos y comisiones) ───────────────────────────────────────
STRIPE_SECRET_KEY=changeme
STRIPE_PUBLISHABLE_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme

# ── ngrok (túnel para webhooks en desarrollo) ─────────────────────────────────
# El plan gratuito de ngrok incluye 1 dominio fijo ("dev domain") que NO cambia
# entre reinicios. Míralo en el dashboard de ngrok → Domains y arranca el túnel
# siempre apuntando a él:
#   ngrok http --url=TU-DOMINIO.ngrok-free.dev 5678
# Así esta URL se configura una sola vez y los webhooks registrados (Stripe,
# Telegram, etc.) no se rompen al reiniciar. Nunca la hardcodees en el código.
NGROK_URL=https://tu-dominio-fijo.ngrok-free.dev

# ── n8n (instancia self-hosted) ───────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# En producción, usar N8N_ENCRYPTION_KEY con un valor aleatorio seguro (32+ chars)
N8N_ENCRYPTION_KEY=changeme

# ── Botpress ──────────────────────────────────────────────────────────────────
# [COMPLETAR-INFO] Añadir variables cuando se configure la instancia de Botpress
# BOTPRESS_TOKEN=changeme
# BOTPRESS_BOT_ID=changeme

# ── Frontend (portal del viajero) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5678

# ── Firebase Authentication (Google Sign-In) ──────────────────────────────────
# Reemplaza con los valores reales de tu proyecto en Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyTuApiKeyDeFirebaseAqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

