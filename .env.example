# ─────────────────────────────────────────────────────────────────────────────
# Just Enjoy — Variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este fichero como ".env" (nunca lo commitees):
#        cp .env.example .env
#   2. Rellena cada variable con el valor real.
#   3. Rota INMEDIATAMENTE cualquier clave que haya quedado en el historial de git.
#
# NOTA DE SEGURIDAD sobre el workflow n8n:
#   El fichero n8n/workflows/Planificador_de_Viajes_v24.json contiene IDs internos
#   de credenciales de n8n (ej: "id": "HEk6ZsM7dKsfAlMs") pero NO las claves reales.
#   Las claves reales se almacenan en la base de datos cifrada de tu instancia n8n
#   y NUNCA deben aparecer en este repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── API keys de servicios (inyectadas al contenedor de n8n) ───────────────────
# docker-compose.yml pasa estas variables al contenedor y las credenciales de
# n8n las leen como expresiones {{ $env.X }} (ver n8n/credentials/credentials.json).
# Al arrancar el stack, el servicio n8n-import crea/actualiza las credenciales
# Y el workflow v27 automáticamente, así que NO hace falta tocar la UI de n8n.
#
# CADA DESARROLLADOR usa SUS PROPIAS claves (cuentas gratuitas): así cada uno
# tiene cuota independiente. Regístrate en cada servicio y pega aquí tu clave:
#   - OpenAI:  https://platform.openai.com/api-keys
#   - SerpAPI: https://serpapi.com/manage-api-key  (free: 250 búsquedas/mes)
#   - Tavily:  https://app.tavily.com  (opcional; contexto de destino)

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=changeme

# ── Anthropic Claude (alternativa a OpenAI para generar itinerarios) ──────────
ANTHROPIC_API_KEY=changeme

# ── SerpAPI (vuelos, hoteles, Google Maps) ────────────────────────────────────
SERPAPI_KEY=changeme

# ── Tavily (búsqueda web) ─────────────────────────────────────────────────────
TAVILY_API_KEY=changeme

# ── Stripe Connect (pagos y comisiones) ───────────────────────────────────────
STRIPE_SECRET_KEY=changeme
STRIPE_PUBLISHABLE_KEY=changeme
STRIPE_WEBHOOK_SECRET=changeme

# ── ngrok (túnel para webhooks en desarrollo) ─────────────────────────────────
# El plan gratuito de ngrok incluye 1 dominio fijo ("dev domain") que NO cambia
# entre reinicios. Míralo en el dashboard de ngrok → Domains y arranca el túnel
# siempre apuntando a él:
#   ngrok http --url=TU-DOMINIO.ngrok-free.dev 5678
# Así esta URL se configura una sola vez y los webhooks registrados (Stripe,
# Telegram, etc.) no se rompen al reiniciar. Nunca la hardcodees en el código.
NGROK_URL=https://tu-dominio-fijo.ngrok-free.dev

# ── n8n (instancia self-hosted) ───────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Clave con la que n8n cifra las credenciales en su BD. Pon un valor aleatorio
# de 32+ chars y NO lo cambies después (si lo cambias, deja de poder leer lo que
# ya cifró). Cada dev puede tener el suyo. Genera uno con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme

# ── Botpress ──────────────────────────────────────────────────────────────────
# [COMPLETAR-INFO] Añadir variables cuando se configure la instancia de Botpress
# BOTPRESS_TOKEN=changeme
# BOTPRESS_BOT_ID=changeme

# ── Frontend (portal del viajero) ─────────────────────────────────────────────
# NOTA: el frontend Next.js lee estas variables desde frontend/.env.local
# (ignorado por git); esta plantilla solo las documenta.
# URL base de la API pública (visible en el cliente por el prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:5678
# Webhook de n8n que el route handler server-side /api/plan-trip invoca para
# generar itinerarios. Es la variable que el código realmente lee. SERVER-ONLY:
# sin prefijo NEXT_PUBLIC_, NO debe exponerse al cliente. En desarrollo, la URL
# del túnel ngrok (dominio fijo) con el path del webhook. Si no se define, el
# frontend cae a los datos mock locales.
N8N_WEBHOOK_URL=https://tu-dominio-fijo.ngrok-free.dev/webhook/travel-planner
# Clave de API de Google Maps (necesaria para mapas interactivos y fotos de Places)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=changeme

# ── Firebase Auth (portal del viajero — Google Sign-In) ───────────────────────
# Obtén estos valores en: https://console.firebase.google.com → Proyecto → Configuración
# NOTA: Las variables NEXT_PUBLIC_ son visibles en el cliente (diseño intencional en Firebase).
NEXT_PUBLIC_FIREBASE_API_KEY=changeme
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=changeme.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=changeme
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=changeme.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=changeme
NEXT_PUBLIC_FIREBASE_APP_ID=changeme

# ── Firebase Admin SDK (verificación de sesión en el SERVIDOR) ─────────────────
# Credenciales de una service account con las que el backend verifica los ID
# tokens y emite/valida las session cookies. Son SECRETAS (a diferencia de las
# NEXT_PUBLIC_ de arriba): nunca deben viajar al cliente ni subirse al repo.
#
# ⚠️ DÓNDE VAN LOS VALORES REALES: el frontend (Next.js) lee sus variables desde
# la carpeta frontend/, NO desde este .env de la raíz. En local ponlas en
# `frontend/.env.local`; en producción, en las Environment Variables de Vercel.
# Aquí solo se documentan.
#
# Cómo obtenerlas: Firebase Console → Configuración del proyecto → Cuentas de
# servicio → "Generar nueva clave privada". Del JSON descargado:
#   - project_id   → FIREBASE_ADMIN_PROJECT_ID
#   - client_email → FIREBASE_ADMIN_CLIENT_EMAIL
#   - private_key  → FIREBASE_ADMIN_PRIVATE_KEY  (en una sola línea, con los
#                    saltos de línea escapados como \n y todo entre comillas)
FIREBASE_ADMIN_PROJECT_ID=changeme
FIREBASE_ADMIN_CLIENT_EMAIL=changeme@changeme.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY=changeme
