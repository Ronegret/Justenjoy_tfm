# ── Secretos y variables de entorno ──────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
credentials/
# Excepción: la estructura de credenciales de n8n SÍ se versiona porque NO
# contiene secretos — los valores son expresiones {{ $env.X }} que n8n resuelve
# en runtime desde el .env (no versionado). Ver n8n/credentials/README.md.
!n8n/credentials/
!n8n/credentials/**

# ── Herramientas IA ───────────────────────────────────────────────────────────
.claude/
.cursor/
.aider/
*.aider*
.continue/
.copilot/

# ── Sesiones y trazas de agentes ─────────────────────────────────────────────
agent-session-*.json
agent-trace-*.jsonl
.claude_session

# ── Node.js / Frontend ───────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.nuxt/
.svelte-kit/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── Editores ──────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Temporales y artefactos de build ─────────────────────────────────────────
*.tmp
*.bak
*.orig
coverage/
.nyc_output/
*.lcov

# ── n8n (instancia local) ─────────────────────────────────────────────────────
# Los workflows JSON SÍ se versionan (en n8n/workflows/).
# Lo que NO se versiona: datos de instancia local, SQLite, sesiones.
n8n-data/
.n8n/

# ── ngrok ─────────────────────────────────────────────────────────────────────
.ngrok/
ngrok.yml

# ── Docker ────────────────────────────────────────────────────────────────────
# Los datos de volúmenes locales de Docker no se versionan
n8n_data/
botpress_data/
# docker-compose.override.yml: override LOCAL por máquina (contiene rutas
# absolutas y la CA de Norton) — NO versionar. Y .env nunca (ya está arriba).
docker-compose.override.yml
# CA raíz local (MITM de Norton) montada por el override — fuera de git
/certs/

.vercel
