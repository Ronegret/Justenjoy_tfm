# Plantilla de variables del FRONTEND. Cópiala como `.env.local` (ignorado por git)
# y rellena los valores. Ver docs/levantar-stack-local.md.
#
#   cp frontend/.env.local.example frontend/.env.local

# ── Firebase Auth (config pública del proyecto; visible en el cliente) ─────────
# Consola de Firebase → Configuración del proyecto → Tus apps (Web).
NEXT_PUBLIC_FIREBASE_API_KEY=changeme
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=changeme.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=changeme
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=changeme.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=changeme
NEXT_PUBLIC_FIREBASE_APP_ID=changeme

# ── Google Maps / Places (config pública; visible en el cliente) ───────────────
# Google Cloud Console → APIs y servicios → Credenciales. Habilita "Maps
# JavaScript API" y "Places API". Restríngela por referrer HTTP (localhost + tu
# dominio). Sin ella, los mapas del itinerario y las fotos reales del destino no
# cargan (la app degrada sin romper).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=changeme

# ── Firebase Admin SDK (SECRETO — verificación de sesión en el servidor) ───────
# Service account del MISMO proyecto Firebase. Te la pasa el equipo de forma
# segura (NUNCA por git). La private_key va en una sola línea con los saltos
# escapados como \n y todo entre comillas.
FIREBASE_ADMIN_PROJECT_ID=changeme
FIREBASE_ADMIN_CLIENT_EMAIL=changeme@changeme.iam.gserviceaccount.com
# El campo private_key del JSON de la service account, en UNA sola línea, con
# los saltos de línea escapados como \n y todo el valor entre comillas dobles.
FIREBASE_ADMIN_PRIVATE_KEY=changeme

# ── Webhook de n8n (server-only, NO se expone al cliente) ──────────────────────
# Con tu n8n en Docker en la misma máquina, apunta a localhost. Si no se define,
# el frontend cae a datos mock. (Para usar el n8n de otra persona: su URL de ngrok.)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/travel-planner
